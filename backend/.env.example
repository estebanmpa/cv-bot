# Port the API server listens on (defaults to 3000)
PORT=

# Comma-separated list of origins allowed by CORS
# (e.g. http://localhost:4000,https://cv.example.com)
CORS_ORIGINS=

# Redis connection URL for the conversation history.
# Inside docker compose: redis://cvbot-cache:6379
# Running the backend locally against the compose Redis: redis://localhost:6381
REDIS_URL=

# Anthropic API key used to generate the bot replies
ANTHROPIC_API_KEY=

# Claude model for the bot replies (e.g. claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Meta WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Any secret string; it must match the "Verify token" set when registering
# the webhook in Meta, which sends it back to GET /webhooks/whatsapp
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Telegram bot token issued by @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram chat id that receives the contact form requests (your own chat with
# the bot). Send the bot a message and read "chat.id" from getUpdates to find it.
TELEGRAM_OWNER_CHAT_ID=
